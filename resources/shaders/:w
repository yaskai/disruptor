float noise(vec3 co) {
    //return fract(sin(dot(co, vec2(12.9898, 1))) * 43758.5453 * time);
    //return fract(sin(dot(co, vec3(0, 1 + time, 0))) * time);

	float val = sin((co.y*50.5) - (time*10.1));
    val -= fract(cos(dot(co, vec3(12.9898, 78.233))) * 43758.5453 + time) * 0.05;
	val = clamp(val, 0.0, 1.0);

	return val;

	//return 1.0;
}

