	vec4 diffuse = vec4(1.0, 0.7, 0.2, 0.9);

	//float dither1 = noise(fragTexCoord);
	float dither1 = noise(fragPosition);
	diffuse = diffuse * dither1;

	diffuse.a = clamp(diffuse.a, 0.0, 0.9);

	finalColor = diffuse;
